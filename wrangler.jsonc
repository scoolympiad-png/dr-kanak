{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dr-kanak",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "PUBLIC_SITE_URL": "https://drkanak.com",
    "PUBLIC_LAUNCH": "false"
  }
}
